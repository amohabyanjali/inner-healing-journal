          { "area": "Chest", "type": "line" },
          { "area": "Stomach", "type": "line" }
        ],
        "prompts": [
          { "question": "What is this tension telling me?", "lines": 1 },
          { "question": "What does my inner child need?", "lines": 1 }
        ],
        "soothing": {
          "instruction": "Gently rub arms, rock, or hum.",
          "reflection": { "label": "After soothing, I feel", "type": "line" }
        },
        "affirmations": [
          "My body is safe for my inner child"
        ]
      }
