    {
      "id": "meet-inner-child",
      "type": "activity",
      "title": "Meet Your Inner Child",
      "content": {
        "sections": [
          {
            "heading": "Guided Visualization",
            "text": "Find a comfortable position. Close your eyes. Take three deep breaths.\n\nImagine a peaceful place—you feel safe here. In the distance, you notice a child approaching. This is you at a younger age.\n\nNotice what they're wearing, their expression, their energy. They've been waiting to meet you.\n\nYou smile gently and say, \"I'm here now. I see you.\"\n\nWhat does your inner child want to tell you? Listen in silence. When ready, open your eyes."
          },
          {
            "heading": "First Meeting",
            "prompts": [
              { "label": "The age I saw", "type": "short" },
              { "label": "Their expression", "type": "line" },
              { "label": "What they wanted to tell me", "type": "multiline", "lines": 4 },
              { "label": "What I want them to know", "type": "multiline", "lines": 3 }
            ]
          }
        ]
      }
    },
    {
      "id": "commitment",
      "type": "activity",
      "title": "Your Commitment",
      "content": {
        "prompts": [
          { "label": "I am beginning this journey because", "type": "multiline", "lines": 3 },
          { "label": "What I hope to heal", "type": "multiline", "lines": 2 }
        ],
        "commitment": {
          "text": "I commit to showing up for my inner child with patience, honesty, and compassion.",
          "fields": [
            { "label": "Signature", "type": "line" },
            { "label": "Date", "type": "line" }
          ]
        }
      }
    },
