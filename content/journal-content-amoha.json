    {
      "id": "day-2",
      "type": "daily",
      "day": 2,
      "week": 1,
      "date": "",
      "title": "EFT Tapping for Safety",
      "content": {
        "practice": {
          "type": "eft",
          "setup": {
            "point": "Karate Chop",
            "repetitions": 3,
            "phrase": "Even though I carry fear from childhood, I deeply accept myself"
          },
          "tapping": [
            { "point": "Eyebrow", "phrase": "This old fear..." },
            { "point": "Side Eye", "phrase": "I was so small..." },
            { "point": "Under Eye", "phrase": "I didn't feel safe..." },
            { "point": "Under Nose", "phrase": "But I'm safe now..." },
            { "point": "Chin", "phrase": "I choose peace..." },
            { "point": "Collarbone", "phrase": "I am protected..." },
            { "point": "Under Arm", "phrase": "I release this fear..." },
            { "point": "Top Head", "phrase": "I am safe as I sleep..." }
          ]
        },
        "reflection": {
          "prompts": [
            { "label": "I feel", "type": "line" },
            { "label": "My body", "type": "line" }
          ]
        },
        "affirmations": [
          "I am safe as I rest and heal"
        ]
      }
    },
    {
