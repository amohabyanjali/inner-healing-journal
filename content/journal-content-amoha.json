    {
      "id": "welcome",
      "type": "text",
      "title": "Welcome, Dear One",
      "content": {
        "sections": [
          {
            "text": "Welcome to your Inner Child Healing Journal. By opening this page, you've taken a courageous step toward healing."
          },
          {
            "text": "Within you lives a child who still carries joy and wounds. This journal is a safe space to meet, listen to, and nurture that precious part of you."
          },
          {
            "text": "Over the next 30 evenings, you'll explore patterns, release emotions, and learn to respond to yourself with the compassion you always deserved."
          },
          {
            "text": "This journey is not about perfection. Some evenings will feel light, others may bring tears. All of it is welcome. Simply show up with honesty and gentleness."
          },
          {
            "text": "Your inner child has been waiting for you."
          },
          {
            "text": "Let's begin."
          }
        ],
        "signature": "With warmth and belief in you"
      }
    },
    {
      "id": "how-to-use",
      "type": "text",
      "title": "How to Use This Journal",
      "content": {
        "sections": [
          {
            "heading": "Your Evening Practice (15-20 minutes)",
            "text": "Complete each evening before bed:",
            "list": [
              "Body scan check-in",
              "Reflective journaling prompt",
              "Inner child dialogue",
              "Gratitude and release"
            ]
          },
          {
            "heading": "Gentle Guidelines",
            "list": [
              "Date pages as you go—no pressure",
              "Skip days if needed",
              "Pace yourself with intense prompts",
              "Find a quiet, comfortable spot",
              "Keep tissues and water nearby",
              "If overwhelmed, pause and use resources on page 2"
            ]
          }
        ]
      }
    },
